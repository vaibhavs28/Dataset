[Unit]
Description=Upstox Nifty 500 15-Minute 1m Candle Ingestion Daemon
After=network.target

[Service]
Type=simple
User=trader
WorkingDirectory=/home/trader/Dataset
ExecStart=/home/trader/Dataset/venv/bin/python3 auto_nifty500_updater.py --daemon
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/trader/Dataset/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
