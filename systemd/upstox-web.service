[Unit]
Description=Upstox Streamlit Market Dashboard (24*7)
After=network.target

[Service]
Type=simple
User=trader
WorkingDirectory=/home/trader/Dataset
ExecStart=/usr/bin/python3 -m streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
